# Copy to evals/.env (gitignored) and fill in. Read with: node --env-file=.env <script>
# Never commit .env.

# Required for the judge. If CLAUDE_CODE_OAUTH_TOKEN below is empty, the
# Claude Code runs bill to this key too.
ANTHROPIC_API_KEY=

# Optional: bill the Claude Code runs to your subscription instead.
# Create it with `claude setup-token` in a normal terminal.
CLAUDE_CODE_OAUTH_TOKEN=

# Optional: the claude executable, if `where claude` doesn't find it
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
