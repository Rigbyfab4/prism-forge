# Copy to evals/.env (gitignored) and fill in. Scripts read it with:
#   node --env-file=.env <script>
# Never commit .env.

# Subscription (no API key needed): runs AND the judge go through Claude Code
# on your Claude plan. Create the token in a normal terminal with:
#   claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Optional, only if you have API access: with a key and no token above, runs
# and the judge bill to the key. With both set, runs use the subscription and
# the judge uses the API.
ANTHROPIC_API_KEY=

# Optional: the claude executable, if `where claude` doesn't find it
# CLAUDE_BIN=C:\Users\you\.local\bin\claude.exe
