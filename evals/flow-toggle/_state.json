{
  "flow": "prism-toggle",
  "description": "Mid-session on/off switching on the feature/enable-disable branch: through the prism-toggle mod (/prism) and through the CLI alone. v1 repeats it with the UserPromptSubmit hook output fixed.",
  "cases_dir": "cases-toggle",
  "arms": {
    "baseline": "prism-toggle-on",
    "v1": "prism-toggle-hookfix"
  },
  "refs": {
    "prism-toggle": "fork/feature/enable-disable"
  },
  "judge": false,
  "metrics": [
    {
      "id": "checks",
      "label": "Checks",
      "kind": "float",
      "scale": 1
    }
  ],
  "perf_fields": [
    {
      "id": "cost_usd",
      "label": "Cost",
      "unit": "$"
    },
    {
      "id": "latency_s",
      "label": "Latency",
      "unit": "s"
    },
    {
      "id": "persona_tags",
      "label": "Persona tags"
    },
    {
      "id": "tagged_turns",
      "label": "Persona turns"
    }
  ],
  "harness_paths": [
    "lib/eval-case.mjs",
    "lib/arms.mjs",
    "lib/claude.mjs",
    "lib/checks.mjs",
    "lib/source.mjs",
    "lib/prices.mjs",
    "cases-toggle/toggle.json"
  ]
}
